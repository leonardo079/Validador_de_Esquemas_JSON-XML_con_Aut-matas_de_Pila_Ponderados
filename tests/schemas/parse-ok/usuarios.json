{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ejemplo.co/usuarios.json",
  "title": "Lista de usuarios",
  "type": "object",
  "properties": {
    "users": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "email": { "type": "string", "format": "email" },
          "edad": { "type": ["integer", "null"], "minimum": 0, "exclusiveMaximum": 150 }
        },
        "required": ["name", "email"],
        "additionalProperties": false
      }
    }
  },
  "required": ["users"]
}
