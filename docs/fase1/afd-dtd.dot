digraph afd_dtd {
  rankdir=LR;
  label="AFD del tokenizador DTD (D86)\n(las transiciones omitidas van al estado de error; las punteadas dependen de un registro)\nTambién van al error, según un registro y sin dibujarse:\n• <!ENTITY y <!DOCTYPE (palabra clave en cualquier caja): error en su <\n• &nombre; que no es lt, gt, amp, quot ni apos\n• &#N; o &#xN; fuera de la producción Char\n• carácter no ASCII entre declaraciones que no es el BOM inicial";
  labelloc=t;
  node [shape=circle, fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=10];
  __start [shape=point, label=""];
  s0 [shape=doublecircle, label="entre declaraciones"];
  s1 [shape=circle, label="<"];
  s2 [shape=circle, label="<!"];
  s3 [shape=circle, label="palabra clave"];
  s4 [shape=circle, label="declaración"];
  s5 [shape=circle, label="nombre"];
  s6 [shape=circle, label="#"];
  s7 [shape=circle, label=") o sufijo"];
  s8 [shape=circle, label="literal\""];
  s9 [shape=circle, label="literal'"];
  s10 [shape=circle, label="fin literal"];
  s11 [shape=circle, label="&"];
  s12 [shape=circle, label="&nombre"];
  s13 [shape=circle, label="&#"];
  s14 [shape=circle, label="&#dec"];
  s15 [shape=circle, label="&#x"];
  s16 [shape=circle, label="&#xhex"];
  s17 [shape=circle, label="<!-"];
  s18 [shape=circle, label="comentario"];
  s19 [shape=circle, label="com -"];
  s20 [shape=circle, label="com --"];
  s21 [shape=circle, label="<?"];
  s22 [shape=circle, label="<?nombre"];
  s23 [shape=circle, label="<?nombre?"];
  s24 [shape=circle, label="<?nombre …"];
  s25 [shape=circle, label="<?… ?"];
  __start -> s0;
  s0 -> s0 [label="␠, \\t \\n \\r, 80–FF"];
  s0 -> s1 [label="<"];
  s1 -> s2 [label="!"];
  s1 -> s21 [label="?"];
  s2 -> s3 [label="x, a–f A–F, letra _ :"];
  s2 -> s17 [label="-"];
  s3 -> s0 [label=">"];
  s3 -> s3 [label="x, a–f A–F, letra _ :"];
  s3 -> s4 [label="␠, \\t \\n \\r"];
  s4 -> s0 [label=">"];
  s4 -> s4 [label="␠, \\t \\n \\r, (, |, ,"];
  s4 -> s5 [label="-, 0–9, x, a–f A–F, letra _ :, ., 80–FF"];
  s4 -> s6 [label="#"];
  s4 -> s7 [label=")"];
  s4 -> s8 [label="\""];
  s4 -> s9 [label="'"];
  s5 -> s0 [label=">"];
  s5 -> s4 [label="␠, \\t \\n \\r, |, ,"];
  s5 -> s5 [label="-, 0–9, x, a–f A–F, letra _ :, ., 80–FF"];
  s5 -> s7 [label="?, ), *, +"];
  s6 -> s5 [label="x, a–f A–F, letra _ :"];
  s7 -> s0 [label=">"];
  s7 -> s4 [label="␠, \\t \\n \\r, |, ,"];
  s7 -> s7 [label="?, ), *, +"];
  s8 -> s8 [label="Σ − {<, &, \", control}"];
  s8 -> s10 [label="\""];
  s8 -> s11 [label="&"];
  s9 -> s9 [label="Σ − {<, &, ', control}"];
  s9 -> s10 [label="'"];
  s9 -> s11 [label="&"];
  s10 -> s0 [label=">"];
  s10 -> s4 [label="␠, \\t \\n \\r"];
  s11 -> s12 [label="x, a–f A–F, letra _ :"];
  s11 -> s13 [label="#"];
  s12 -> s8 [label=";"];
  s12 -> s12 [label="-, 0–9, x, a–f A–F, letra _ :, ."];
  s13 -> s14 [label="0–9"];
  s13 -> s15 [label="x"];
  s14 -> s8 [label=";"];
  s14 -> s14 [label="0–9"];
  s15 -> s16 [label="0–9, a–f A–F"];
  s16 -> s8 [label=";"];
  s16 -> s16 [label="0–9, a–f A–F"];
  s17 -> s18 [label="-"];
  s18 -> s18 [label="Σ − {-, control}"];
  s18 -> s19 [label="-"];
  s19 -> s18 [label="Σ − {-, control}"];
  s19 -> s20 [label="-"];
  s20 -> s0 [label=">"];
  s21 -> s22 [label="x, a–f A–F, letra _ :, 80–FF"];
  s22 -> s22 [label="-, 0–9, x, a–f A–F, letra _ :, ., 80–FF"];
  s22 -> s23 [label="?"];
  s22 -> s24 [label="␠, \\t \\n \\r"];
  s23 -> s0 [label=">"];
  s24 -> s24 [label="Σ − {?, control}"];
  s24 -> s25 [label="?"];
  s25 -> s0 [label=">"];
  s25 -> s24 [label="Σ − {>, ?, control}"];
  s25 -> s25 [label="?"];
  s12 -> s9 [style=dashed, label="; (si el literal es con ')"];
  s14 -> s9 [style=dashed, label="; (si el literal es con ')"];
  s16 -> s9 [style=dashed, label="; (si el literal es con ')"];
}
