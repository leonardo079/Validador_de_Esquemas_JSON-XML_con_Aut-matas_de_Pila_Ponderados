  s38 -> s39 [label="x, a–c e f B E F, A, C, D, T, d, letra _ :, 80–FF"];
  s39 -> s16 [label="␠, \\t \\n \\r"];
  s39 -> s39 [label="-, ., 0–9, x, a–c e f B E F, A, C, D, T, d, letra _ :, 80–FF"];
  s39 -> s40 [label="?"];
  s40 -> s0 [label=">"];
  s33 -> s9 [style=dashed, label="; [regreso = valor\"]"];
  s33 -> s10 [style=dashed, label="; [regreso = valor']"];
  s35 -> s9 [style=dashed, label="; [regreso = valor\"]"];
  s35 -> s10 [style=dashed, label="; [regreso = valor']"];
  s37 -> s9 [style=dashed, label="; [regreso = valor\"]"];
  s37 -> s10 [style=dashed, label="; [regreso = valor']"];
}
