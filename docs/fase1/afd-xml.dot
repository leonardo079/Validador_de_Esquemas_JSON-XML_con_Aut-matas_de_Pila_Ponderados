  s27 -> s28 [label="A"];
  s28 -> s29 [label="["];
  s29 -> s29 [label="Σ − {], control}"];
  s29 -> s30 [label="]"];
  s30 -> s29 [label="Σ − {], control}"];
  s30 -> s31 [label="]"];
  s31 -> s0 [label=">"];
