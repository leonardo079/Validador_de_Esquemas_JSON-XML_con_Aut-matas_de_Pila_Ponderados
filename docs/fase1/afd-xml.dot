  s14 -> s15 [label="␠, \\t \\n \\r"];
  s15 -> s0 [label=">"];
  s15 -> s15 [label="␠, \\t \\n \\r"];
  s16 -> s16 [label="Σ − {?, control}"];
  s16 -> s17 [label="?"];
