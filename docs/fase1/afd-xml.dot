  s5 -> s6 [label="x, a–c e f B E F, A, C, D, T, d, letra _ :, 80–FF"];
  s5 -> s12 [label="/"];
  s6 -> s6 [label="-, ., 0–9, x, a–c e f B E F, A, C, D, T, d, letra _ :, 80–FF"];
  s6 -> s7 [label="␠, \\t \\n \\r"];
  s6 -> s8 [label="="];
  s7 -> s7 [label="␠, \\t \\n \\r"];
  s7 -> s8 [label="="];
  s8 -> s8 [label="␠, \\t \\n \\r"];
  s8 -> s9 [label="\""];
