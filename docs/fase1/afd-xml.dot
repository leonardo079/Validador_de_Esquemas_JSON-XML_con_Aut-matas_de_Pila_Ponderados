digraph xml {
  rankdir=LR;
  label="AFD del tokenizador XML (subconjunto de XML 1.0, sin DTD)\n(las transiciones omitidas van al estado de error; las punteadas dependen de un registro)\nTambién van al error, según un registro y sin dibujarse:\n• &nombre con más de 4 bytes, o ; tras un nombre que no es lt, gt, amp, quot ni apos: UndefinedEntity\n• dígito de &#… o &#x… que lleva el valor por encima de 10FFFF, o ; con un valor fuera de la producción Char: InvalidCharRef\n• carácter decodificado fuera de Char (U+FFFE, U+FFFF): InvalidXmlChar\n• byte no ASCII que el AFD UTF-8 (en producto, afd-utf8) rechaza: InvalidUtf8";
  labelloc=t;
  node [shape=circle, fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=10];
  __start [shape=point, label=""];
  s0 [shape=doublecircle, label="contenido"];
  s1 [shape=doublecircle, label="]"];
  s2 [shape=doublecircle, label="]]"];
  s3 [shape=circle, label="<"];
  s4 [shape=circle, label="nombre"];
  s5 [shape=circle, label="etiqueta␠"];
  s6 [shape=circle, label="atributo"];
  s7 [shape=circle, label="atributo␠"];
  s8 [shape=circle, label="="];
  s9 [shape=circle, label="valor\""];
  s10 [shape=circle, label="valor'"];
  s11 [shape=circle, label="fin valor"];
  s12 [shape=circle, label="/"];
  s13 [shape=circle, label="</"];
  s14 [shape=circle, label="nombre cierre"];
  s15 [shape=circle, label="cierre␠"];
  s16 [shape=circle, label="<?nombre …"];
  s17 [shape=circle, label="<?… ?"];
  s18 [shape=circle, label="<!"];
  s19 [shape=circle, label="<!-"];
  s20 [shape=circle, label="comentario"];
  s21 [shape=circle, label="com -"];
  s22 [shape=circle, label="com --"];
  s23 [shape=circle, label="<!["];
  s24 [shape=circle, label="<![C"];
  s25 [shape=circle, label="<![CD"];
  s26 [shape=circle, label="<![CDA"];
  s27 [shape=circle, label="<![CDAT"];
  s28 [shape=circle, label="<![CDATA"];
  s29 [shape=circle, label="CDATA"];
  s30 [shape=circle, label="CDATA ]"];
  s31 [shape=circle, label="CDATA ]]"];
  s32 [shape=circle, label="&"];
  s33 [shape=circle, label="&nombre"];
  s34 [shape=circle, label="&#"];
  s35 [shape=circle, label="&#dec"];
  s36 [shape=circle, label="&#x"];
  s37 [shape=circle, label="&#xhex"];
  s38 [shape=circle, label="<?"];
  s39 [shape=circle, label="<?nombre"];
  s40 [shape=circle, label="<?nombre?"];
  __start -> s0;
  s0 -> s0 [label="Σ − {<, &, ], control}"];
  s0 -> s1 [label="]"];
  s0 -> s3 [label="<"];
  s0 -> s32 [label="&"];
  s1 -> s0 [label="Σ − {<, &, ], control}"];
  s1 -> s2 [label="]"];
  s1 -> s3 [label="<"];
  s1 -> s32 [label="&"];
  s2 -> s0 [label="Σ − {<, >, &, ], control}"];
  s2 -> s2 [label="]"];
  s2 -> s3 [label="<"];
  s2 -> s32 [label="&"];
  s3 -> s4 [label="x, a–c e f B E F, A, C, D, T, d, letra _ :, 80–FF"];
  s3 -> s13 [label="/"];
  s3 -> s18 [label="!"];
  s3 -> s38 [label="?"];
  s4 -> s0 [label=">"];
  s4 -> s4 [label="-, ., 0–9, x, a–c e f B E F, A, C, D, T, d, letra _ :, 80–FF"];
  s4 -> s5 [label="␠, \\t \\n \\r"];
  s4 -> s12 [label="/"];
  s5 -> s0 [label=">"];
