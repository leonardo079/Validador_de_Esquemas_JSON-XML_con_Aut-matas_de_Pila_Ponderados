  s31 -> s31 [label="]"];
  s32 -> s33 [label="x, a–c e f B E F, A, C, D, T, d, letra _ :"];
  s32 -> s34 [label="#"];
  s33 -> s0 [label=";"];
  s33 -> s33 [label="-, ., 0–9, x, a–c e f B E F, A, C, D, T, d, letra _ :"];
  s34 -> s35 [label="0–9"];
  s34 -> s36 [label="x"];
  s35 -> s0 [label=";"];
  s35 -> s35 [label="0–9"];
