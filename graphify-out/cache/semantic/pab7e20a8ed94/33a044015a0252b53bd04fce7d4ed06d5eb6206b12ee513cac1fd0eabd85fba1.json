{"nodes": [{"id": "docs_fase2_gramatica_esquema", "label": "Fase 2: Gramatica del metalenguaje de esquemas", "file_type": "document", "source_file": "docs/fase2/gramatica-esquema.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_fase2_gramatica_esquema_keyword_classes", "label": "Clases de palabra clave K_*", "file_type": "concept", "source_file": "docs/fase2/gramatica-esquema.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Una STRING como clave de objeto-esquema se clasifica por su valor (tabla KEYWORDS en ast.rs) para que el parser compruebe la forma del valor en una sola pasada"}, {"id": "docs_fase2_gramatica_esquema_k_other", "label": "K_OTHER (palabras clave fuera del subconjunto)", "file_type": "concept", "source_file": "docs/fase2/gramatica-esquema.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Existe para que las palabras clave no soportadas no se pierdan: se guardan como Kw::Unsupported y la Fase 3 las rechaza con nombre"}, {"id": "docs_fase2_gramatica_esquema_schema_ll1_grammar", "label": "Gramatica LL(1) del esquema (esquema.ll1)", "file_type": "concept", "source_file": "docs/fase2/gramatica-esquema.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Escrita sin recursion izquierda ni prefijos comunes; listas X -> item X_tail | eps"}, {"id": "docs_fase2_gramatica_esquema_homomorfismo_k_string", "label": "Homomorfismo K_* -> STRING", "file_type": "rationale", "source_file": "docs/fase2/gramatica-esquema.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Borrar las clases convierte cada derivacion en una de JSON: todo esquema aceptado es JSON"}, {"id": "docs_fase2_gramatica_esquema_claves_repetidas", "