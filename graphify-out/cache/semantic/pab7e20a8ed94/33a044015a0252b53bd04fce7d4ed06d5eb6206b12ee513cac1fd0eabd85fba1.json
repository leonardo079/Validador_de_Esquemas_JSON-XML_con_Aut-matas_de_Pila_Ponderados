fase2_gramatica_esquema_recursive_descent_parser", "label": "Parser descendente recursivo (json_schema.rs)", "file_type": "concept", "source_file": "docs/fase2/gramatica-esquema.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Una funcion por no terminal; su pila de llamadas es la pila del automata"}, {"id": "docs_fase2_gramatica_esquema_fase2_vs_fase3_checks", "label": "Division de comprobaciones Fase 2 / Fase 3", "file_type": "rationale", "source_file": "docs/fase2/gramatica-esquema.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La gramatica fija la forma; lo no libre de contexto o dependiente del valor es semantico"}], "edges": [{"source": "docs_fase2_gramatica_esquema", "target": "docs_fase2_gramatica_esquema_keyword_classes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/fase2/gramatica-esquema.md", "source_location": null, "weight": 1.0}, {"source": "docs_fase2_gramatica_esquema", "target": "docs_fase2_gramatica_esquema_k_other", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/fase2/gramatica-esquema.md", "source_location": null, "weight": 1.0}, {"source": "docs_fase2_gramatica_esquema", "target": "docs_fase2_gramatica_esquema_schema_ll1_grammar", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/fase2/gramatica-esquema.md", "source_location": null, "weight": 1.0}, {"source": "docs_fase2_gramatica_esquema", "target": "docs_fase2_gramatica_esquema_homomorfismo_k_string", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/fase2/gramatica-esquema.md", "source_location": null, "weight": 1.0}, {"source": "docs_fase2_gramatica_esquema", "target": "docs_fase2_gramatica_esquema_claves_repetidas", "relation": "references", "co